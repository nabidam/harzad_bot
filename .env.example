TOKEN=
BOT_NAME=
SQLITE=
ADMINS=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# PROXY_LIST: comma-separated proxy pool used by the Instagram fallbacks
# (None or empty = off). NOT used for Spotify/Telegram traffic.
PROXY_LIST=None
ADMIN_TELEGRAM_USER_ID=
INSTAGRAM_USER=
INSTAGRAM_PASSWORD=

DOWNLOAD_MP3_PATH=/home/user/share_folder/mp3s/
DOWNLOAD_VIDEO_PATH=/home/user/share_folder/videos/

HOSTNAME=http://localhost/
HOST_ROOT=/home/user/share_folder/
SCRIPT_DIR=/home/user/bot/

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
HF_TOKEN=
REPLICATE_API_TOKEN=
TOGETHER_API_KEY=
USE_OLLAMA=True

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

YT_COOKIE_FILE=
# YT_PROXY: explicit --proxy passed to yt-dlp for MP3/video downloads.
# Spotify URL resolves (spotipy/requests) instead inherit the process
# http_proxy/https_proxy env vars (e.g. http://127.0.0.1:10808 -> xray).
YT_PROXY=http://127.0.0.1:10808
# TG_PROXY: proxy for the Telegram Bot API calls (PTB/HTTPXRequest).
# httpx does NOT read http_proxy/https_proxy env vars, so on a box without
# direct egress this must be set explicitly (e.g. http://127.0.0.1:10808).
# Empty = direct egress.
TG_PROXY=

DB_URI=