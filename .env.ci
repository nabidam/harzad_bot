# Committed dummy environment for CI. NO SECRETS.
#
# configurations.settings reads strict env vars at import time. On a dev box
# the real .env provides them; on CI runners .env does not exist, so
# tests/conftest.py loads THIS file to fill the gap (load_dotenv never
# overrides vars that are already set — real .env always wins locally).
#
# DB_URI is NOT set here: tests/conftest.py pins it to the CI postgres
# service (127.0.0.1:5432/harzad_db).
TOKEN=dummy-ci-token
BOT_NAME=ci_bot
SQLITE=../ci.db
ADMINS=0
SPOTIFY_CLIENT_ID=ci
SPOTIFY_CLIENT_SECRET=ci
PROXY_LIST=None
ADMIN_TELEGRAM_USER_ID=0
INSTAGRAM_USER=
INSTAGRAM_PASSWORD=
HOSTNAME=http://localhost:8377/
# Unreachable by design: AI tests use the fake_llm fixture, and a real
# call must fail fast instead of hitting a dev-box LLM.
LLM_BASE_URL=http://127.0.0.1:9/v1
LLM_API_KEY=dummy
LLM_MODEL=dummy
HF_TOKEN=ci
REPLICATE_API_TOKEN=ci
TOGETHER_API_KEY=ci
YT_PROXY=
TG_PROXY=
MINIAPP_URL=
